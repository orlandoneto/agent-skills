{
  "$schema": "./policy.schema.json",
  "version": 1,
  "description": "Gates anti-lixo, licença, malware e duplicata. Crawler publica SAFE no Git+catalog (buscador); scripts ficam em staging.",
  "licenses": {
    "allow": ["MIT", "Apache-2.0", "Apache 2.0", "BSD-2-Clause", "BSD-3-Clause", "CC0-1.0", "Unlicense", "ISC"],
    "deny": ["NONE", "UNKNOWN", "UNLICENSED-PROPRIETARY"],
    "requireDeclaredLicense": true
  },
  "security": {
    "autoPublishAllowedIfHasScripts": false,
    "autoPublishAllowedIfHasBinaries": false,
    "blockedExtensions": [".exe", ".dll", ".bat", ".cmd", ".ps1", ".sh", ".bash", ".zsh", ".msi", ".dmg"],
    "blockedPathFragments": ["node_modules/", ".git/", "credentials", ".env"]
  },
  "quality": {
    "minDescriptionLength": 40,
    "maxSkillMdBytes": 128000,
    "minSkillMdBytes": 120,
    "requireNameMatchesFolder": true,
    "minScoreToAutoPropose": 40,
    "minScoreToPublish": 60
  },
  "dedupe": {
    "normalizeName": true,
    "hashBody": true,
    "rejectIfSameFingerprintExists": true
  },
  "crawler": {
    "maxCandidatesPerDay": 400,
    "maxAutoPromotePerDay": 250,
    "maxPublishedCommunity": 600,
    "scheduleTimezone": "America/Sao_Paulo",
    "userAgent": "OntoomSkillCrawler/1.0 (+https://www.ontoom.com.br/skills; respect robots; 1x/day)",
    "discovery": {
      "enabled": true,
      "ownRepo": "orlandoneto/agent-skills",
      "maxNewReposPerDay": 8,
      "maxPagesPerQueryPerDay": 2,
      "maxPagesTotalPerQuery": 10,
      "recheckDays": 7,
      "note": "GitHub Search only → staging/discovery-state.json + dynamic-sources.json. Google/SERP proibido. Postgres/Redis = futuro."
    },
    "sourcesAllowlist": [
      {
        "id": "addyosmani-agent-skills",
        "type": "github-repo-skills",
        "repo": "addyosmani/agent-skills",
        "path": "skills",
        "defaultLicense": "MIT",
        "enabled": true
      },
      {
        "id": "anthropics-skills",
        "type": "github-repo-skills",
        "repo": "anthropics/skills",
        "path": "skills",
        "defaultLicense": "Apache-2.0",
        "enabled": true
      },
      {
        "id": "vercel-labs-agent-skills",
        "type": "github-repo-skills",
        "repo": "vercel-labs/agent-skills",
        "path": "skills",
        "defaultLicense": "MIT",
        "enabled": true
      },
      {
        "id": "solonnikov-agent-skills",
        "type": "github-repo-skills",
        "repo": "Solonnikov/agent-skills",
        "path": "skills",
        "defaultLicense": "MIT",
        "enabled": true
      },
      {
        "id": "promptingcompany-agent-skills",
        "type": "github-repo-skills",
        "repo": "promptingcompany/agent-skills",
        "path": "skills",
        "defaultLicense": "MIT",
        "enabled": true
      },
      {
        "id": "coreyhaines-marketingskills",
        "type": "github-repo-skills",
        "repo": "coreyhaines31/marketingskills",
        "path": "skills",
        "defaultLicense": "MIT",
        "idNamespace": "ms",
        "nested": false,
        "enabled": true
      },
      {
        "id": "agricidaniel-claude-seo",
        "type": "github-repo-skills",
        "repo": "AgriciDaniel/claude-seo",
        "path": "skills",
        "defaultLicense": "MIT",
        "idNamespace": "claude-seo",
        "nested": false,
        "enabled": true
      },
      {
        "id": "kostja94-marketing-skills",
        "type": "github-repo-skills",
        "repo": "kostja94/marketing-skills",
        "path": "skills",
        "defaultLicense": "MIT",
        "idNamespace": "kostja",
        "nested": true,
        "maxDepth": 4,
        "enabled": true
      },
      {
        "id": "aaron-seo-geo",
        "type": "github-repo-skills",
        "repo": "aaron-he-zhu/aaron-marketing-skills",
        "path": "seo-geo",
        "defaultLicense": "Apache-2.0",
        "idNamespace": "aaron-seo",
        "nested": true,
        "maxDepth": 4,
        "enabled": true
      },
      {
        "id": "aaron-narrative",
        "type": "github-repo-skills",
        "repo": "aaron-he-zhu/aaron-marketing-skills",
        "path": "narrative",
        "defaultLicense": "Apache-2.0",
        "idNamespace": "aaron-tale",
        "nested": true,
        "maxDepth": 4,
        "enabled": true
      },
      {
        "id": "aaron-social",
        "type": "github-repo-skills",
        "repo": "aaron-he-zhu/aaron-marketing-skills",
        "path": "social",
        "defaultLicense": "Apache-2.0",
        "idNamespace": "aaron-echo",
        "nested": true,
        "maxDepth": 4,
        "enabled": true
      },
      {
        "id": "aaron-email",
        "type": "github-repo-skills",
        "repo": "aaron-he-zhu/aaron-marketing-skills",
        "path": "email",
        "defaultLicense": "Apache-2.0",
        "idNamespace": "aaron-send",
        "nested": true,
        "maxDepth": 4,
        "enabled": true
      },
      {
        "id": "notque-vexjoy-agent",
        "type": "github-repo-skills",
        "repo": "notque/vexjoy-agent",
        "path": "skills",
        "defaultLicense": "MIT",
        "idNamespace": "notque",
        "nested": true,
        "maxDepth": 5,
        "enabled": true
      },
      {
        "id": "davila7-claude-code-templates",
        "type": "github-repo-skills",
        "repo": "davila7/claude-code-templates",
        "path": "cli-tool/components/skills",
        "defaultLicense": "MIT",
        "idNamespace": "aitmpl",
        "nested": true,
        "maxDepth": 6,
        "enabled": true
      },
      {
        "id": "ckorhonen-claude-skills",
        "type": "github-repo-skills",
        "repo": "ckorhonen/claude-skills",
        "path": "skills",
        "defaultLicense": "MIT",
        "idNamespace": "ck",
        "nested": true,
        "maxDepth": 4,
        "enabled": true
      },
      {
        "id": "manual-seed",
        "type": "local-manifest",
        "path": "staging/seed-sources.json",
        "enabled": true
      }
    ],
    "forbiddenBehaviors": [
      "mirror-entire-awesome-list",
      "scrape-google-or-web-serp",
      "publish-from-discovery-without-gates",
      "more-than-one-full-pass-per-day-per-source",
      "publish-without-license-gate",
      "publish-skills-with-scripts-automatically"
    ]
  },
  "publishing": {
    "publicStatuses": ["published"],
    "seoIndexStatuses": ["published"],
    "downloadMustBePerSkillZip": true
  }
}
